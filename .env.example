# ============================================================
# SIGREF - Variables de Entorno para Producción
# ============================================================
# Copia este archivo a .env y configura los valores apropiados
# IMPORTANTE: Nunca commits el archivo .env al repositorio
# ============================================================

# ============================================================
# DOMINIO PÚBLICO (Cloudflare Tunnel)
# ============================================================
# Tu dominio público sin protocolo (ej: sigref.ejemplo.com)
PUBLIC_DOMAIN=sigref.ejemplo.com

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_USER=sigref_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_32_CHARS
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================
# MONGODB
# ============================================================
MONGODB_USER=mongo_user
MONGODB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_32_CHARS
MONGODB_HOST=mongodb
MONGODB_PORT=27017

# ============================================================
# KEYCLOAK
# ============================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_32_CHARS
# Usar el dominio público (sin protocolo)
KEYCLOAK_HOSTNAME=sigref.ejemplo.com
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak

# ============================================================
# HAPI FHIR
# ============================================================
HAPI_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hapi
HAPI_DRIVER_CLASS=org.postgresql.Driver
HAPI_HIBERNATE_DIALECT=ca.uhn.fhir.jpa.model.dialect.HapiFhirPostgresDialect
HAPI_ALLOW_EXTERNAL_REFS=true
HAPI_ALLOW_MULTIPLE_DELETE=true
HAPI_FHIR_VERSION=R4
# URL del servidor FHIR (interno, no se expone públicamente)
HAPI_SERVER_ADDRESS=http://hapifhir:8080/fhir
# OAuth (interno via Keycloak)
HAPI_OAUTH_ISSUER=http://keycloak:8080/auth/realms/sigref
HAPI_OAUTH_CLIENT_ID=hapi-fhir
HAPI_OAUTH_CLIENT_SECRET=CAMBIAR_POR_SECRET_DE_KEYCLOAK

# ============================================================
# SIGREF API
# ============================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ============================================================
# FRONTEND
# ============================================================
# URLs públicas con HTTPS (Cloudflare SSL)
FRONTEND_KEYCLOAK_URL=https://sigref.ejemplo.com/auth
FRONTEND_API_URL=https://sigref.ejemplo.com
FRONTEND_URL=https://sigref.ejemplo.com

# ============================================================
# ASPIRE DASHBOARD (Monitoreo en tiempo real)
# ============================================================
# Puerto local para acceso directo (solo admin)
DASHBOARD_PORT=18888
# Secret del cliente OIDC en Keycloak
DASHBOARD_CLIENT_SECRET=CAMBIAR_POR_SECRET_DE_KEYCLOAK
# Rol requerido para acceder (configurar en Keycloak)
DASHBOARD_REQUIRED_ROLE=ti

# ============================================================
# SEQ (Persistencia de Logs)
# ============================================================
# Puerto para UI de Seq (acceso local)
SEQ_PORT=5341
# Contraseña inicial del admin (cambiar después de configurar OIDC)
SEQ_ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
# URL canónica para redirecciones (si se expone públicamente)
SEQ_CANONICAL_URI=http://localhost:5341
# API Key para ingestion desde OTel Collector
# Generar en Seq UI: Settings > API Keys > Add API Key
SEQ_API_KEY=GENERAR_EN_SEQ_UI_DESPUES_DE_INICIAR

# ============================================================
# NGINX
# ============================================================
# Puerto HTTP (Cloudflare Tunnel se conecta aquí)
NGINX_PORT=80

# ============================================================
# OPENTELEMETRY (Opcional - valores por defecto funcionan)
# ============================================================
# Endpoint del collector (no cambiar a menos que sea necesario)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
