FROM alpine:latest

# Instalar curl, jq y bash
RUN apk add --no-cache curl jq bash

# Crear usuario no root
RUN addgroup -S keycloak && adduser -S keycloak -G keycloak

# Crear directorio de trabajo
RUN mkdir -p /opt/keycloak/data/import && chown -R keycloak:keycloak /opt/keycloak

# Copiar scripts de inicialización
COPY init-keycloak.sh /usr/local/bin/init-keycloak.sh
COPY keycloak-realm.json /opt/keycloak/data/import/keycloak-realm.json

# Hacer ejecutable el script y ajustar permisos
RUN chmod +x /usr/local/bin/init-keycloak.sh && \
    chown keycloak:keycloak /usr/local/bin/init-keycloak.sh && \
    chown keycloak:keycloak /opt/keycloak/data/import/keycloak-realm.json

# Cambiar al usuario no root
USER keycloak

# Comando por defecto
CMD ["/usr/local/bin/init-keycloak.sh"]