{
  "resourcePermissions": [
    {
      "resourceType": "Patient",
      "compartment": "Patient",
      "rule": "ALLOW_ALL",
      "appliesTo": ["READ", "WRITE"],
      "requiredScopes": ["patient/*.read", "patient/*.write"]
    },
    {
      "resourceType": "Practitioner",
      "rule": "ALLOW_ALL",
      "appliesTo": ["READ"],
      "requiredScopes": ["user/*.read"],
      "requiredRoles": ["doctor", "nurse", "admin"]
    },
    {
      "resourceType": "Observation",
      "compartment": "Patient",
      "rule": "ALLOW_ALL",
      "appliesTo": ["READ", "WRITE"],
      "requiredScopes": ["patient/*.read", "patient/*.write"]
    },
    {
      "resourceType": "Medication",
      "rule": "ALLOW_ALL",
      "appliesTo": ["READ"],
      "requiredRoles": ["doctor", "pharmacist", "admin"]
    },
    {
      "resourceType": "MedicationRequest",
      "rule": "ALLOW_ALL",
      "appliesTo": ["READ", "WRITE"],
      "requiredRoles": ["doctor", "admin"]
    }
  ],
  "defaultRule": "DENY"
}
