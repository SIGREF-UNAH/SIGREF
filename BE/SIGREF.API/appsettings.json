{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowURLS": [
    "http://localhost:5173",
    "http://localhost:3000",
    "http://localhost:4200"
  ],
  "Fhir": {
    "BaseUrl": "http://localhost:8080/fhir"             // Local HAPI FHIR Server
    // "BaseUrl": "https://hapi.solarium.dev/fhir"      // Public HAPI FHIR Server
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/sigref", // Keycloak URL (Realm)
    "Audience": "sigref-api",                           // Client ID
    "RequireHttps": false                               // Cambiar a true en producción
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "AllowedHosts": "*"
}
