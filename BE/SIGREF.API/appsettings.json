{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Mongo": {
    "ConnectionString": "mongodb://sigref:SuperSecretPassword@mongo-sigref-logs:27017",
    "Database": "sigref_logs"
  },
  "AllowURLS": [
    "http://localhost:5173",
    "http://localhost:3000",
    "http://localhost:4200"
  ],
  "Fhir": {
    "BaseUrl": "http://localhost:8080/fhir"
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/sigref", 
    "Audience": "backend",                              
    "RequireHttps": false                              
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "AllowedHosts": "*"
}
