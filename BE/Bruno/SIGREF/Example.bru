meta {
  name: Example
  type: http
  seq: 1
}

get {
  url: 
  body: none
  auth: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: https://localhost:7107/swagger
  authorization_url: http://localhost:8081/realms/fhir/protocol/openid-connect/auth
  access_token_url: http://localhost:8081/realms/fhir/protocol/openid-connect/token
  refresh_token_url: 
  client_id: Postman
  client_secret: 
  scope: SIGREF-Api.all
  state: 
  pkce: false
  credentials_placement: basic_auth_header
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}
