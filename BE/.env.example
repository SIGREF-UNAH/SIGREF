# ============================================================================
# CAMBIOS APLICADOS (Codex, 2026-09-17)
# Plantilla de variables para Docker Compose. Copiela como .env localmente y
# reemplace los valores CHANGE_ME; .env esta excluido del contexto Docker/Git.
# En produccion, inyecte estos valores con un gestor de secretos.
# ============================================================================

# Imagenes y puertos publicados.
SIGREF_API_IMAGE=sigref-api:local
SIGREF_API_PORT=8080
FRONTEND_IMAGE=sigref-frontend:local
KEYCLOAK_IMAGE=sigref-keycloak:local

# Usuarios y contrasenas: nunca use estos valores de ejemplo en produccion.
POSTGRES_USERNAME=sigref
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
MONGODB_USER=sigref
MONGODB_PASSWORD=CHANGE_ME_MONGODB_PASSWORD
KEYCLOAK_USER=admin
KEYCLOAK_PASS=CHANGE_ME_KEYCLOAK_PASSWORD
