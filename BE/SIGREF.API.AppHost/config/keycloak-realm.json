{
  "realm": "sigref",
  "displayName": "SIGREF Realm",
  "loginTheme": "sigref",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "sigref-api",
      "name": "SIGREF_API",
      "description": "Cliente OIDC para la API de SIGREF",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "sigref-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "publicClient": false,
      "redirectUris": [
        "https://api.localhost/*",
        "http://localhost:8080/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "https://api.localhost",
        "http://localhost:8080",
        "http://localhost:3000"
      ]
    },
    {
      "clientId": "frontend",
      "name": "SIGREF_Frontend",
      "description": "Aplicacion web del SIGREF",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://app.localhost/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://app.localhost"
      ]
    },
    {
      "clientId": "sigref-admin-api",
      "name": "SIGREF Admin API",
      "description": "Cliente interno usado por SIGREF.API para crear y administrar usuarios",
      "enabled": true,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "sigref-admin-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": false
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "cashier",
        "description": "Rol definido en entorno: cashier",
        "composite": false
      },
      {
        "name": "admin",
        "description": "Rol definido en entorno: admin",
        "composite": false
      },
      {
        "name": "ti",
        "description": "Rol definido en entorno: ti",
        "composite": false
      },
      {
        "name": "auditor",
        "description": "Rol definido en entorno: auditor",
        "composite": false
      }
    ]
  },
  "users": [
    {
      "username": "sigref-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "SIGREF",
      "lastName": "Admin",
      "email": "admin@sigref.local",
      "credentials": [
        {
          "type": "password",
          "value": "Admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "cashier",
        "admin",
        "ti",
        "auditor"
      ]
    }
  ]
}