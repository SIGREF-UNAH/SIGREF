# =========================================================
# PostgreSQL Database
# Almacena las bases de datos para HAPI FHIR, Keycloak y SIGREF
# =========================================================
POSTGRES_USER=sigref
POSTGRES_PASSWORD=SuperSecretPassword
POSTGRES_DB=postgres

# =========================================================
# Keycloak (Servidor de Autenticaci�n)
# =========================================================
KEYCLOAK_HOST=keycloak.localhost
KEYCLOAK_PORT=8080

# Roles que se crearon automaticamente dentro del Realm
KEYCLOAK_ROLES=cashier,admin,ti,auditor

# Base de datos usada por Keycloak dentro del mismo contenedor PostgreSQL
KEYCLOAK_DB_USER=sigref
KEYCLOAK_DB_PASS=SuperSecretPassword

# =========================================================
# HAPI FHIR (Servidor de Datos Cl�nicos)
# =========================================================
HAPI_DB_URL=jdbc:postgresql://postgres:5432/hapi
HAPI_DB_USER=sigref
HAPI_DB_PASSWORD=SuperSecretPassword

# =========================================================
# API Principal (SIGREF.API)
# =========================================================
API_HOST=api.localhost

# =========================================================
# Traefik (Reverse Proxy)
# =========================================================
TRAEFIK_DASHBOARD=true
TRAEFIK_PORT=80

# =========================================================
# Keycloak Realm Principal (Configuracion de Importacion Automatica)
# =========================================================
KEYCLOAK_REALM=sigref
KEYCLOAK_REALM_DISPLAY=SIGREF Realm

# Usuario administrador inicial de Keycloak
KEYCLOAK_ADMIN_USERNAME=sigref-admin
KEYCLOAK_ADMIN_EMAIL=admin@sigref.local
KEYCLOAK_ADMIN_FIRSTNAME=SIGREF
KEYCLOAK_ADMIN_LASTNAME=Admin
KEYCLOAK_ADMIN_PASSWORD=Admin123

# =========================================================
# Clientes de Keycloak
# =========================================================
# --- Cliente de administración interna ---
KEYCLOAK_CLIENT_ADMIN_ID=sigref-admin-api
KEYCLOAK_CLIENT_ADMIN_NAME=SIGREF Admin API
KEYCLOAK_CLIENT_ADMIN_SECRET=sigref-admin-secret


# --- Backend (API / audiencia principal)
KEYCLOAK_CLIENT_API_ID=sigref-api
KEYCLOAK_CLIENT_API_NAME=SIGREF_API
KEYCLOAK_CLIENT_API_SECRET=sigref-secret
KEYCLOAK_CLIENT_API_REDIRECT_URIS=https://api.localhost/*,http://localhost:8080/*,http://localhost:3000/*
KEYCLOAK_CLIENT_API_WEB_ORIGINS=https://api.localhost,http://localhost:8080,http://localhost:3000

# --- Frontend (SPA / cliente publico)
KEYCLOAK_CLIENT_FE_ID=frontend
KEYCLOAK_CLIENT_FE_NAME=SIGREF_Frontend
KEYCLOAK_CLIENT_FE_REDIRECT_URIS=http://localhost:5173/*,https://app.localhost/*
KEYCLOAK_CLIENT_FE_WEB_ORIGINS=http://localhost:5173,https://app.localhost
