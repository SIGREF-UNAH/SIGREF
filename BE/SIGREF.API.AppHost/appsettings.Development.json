{
  "ConnectionStrings": {
    "mongodb": "mongodb://localhost:27017",
    "DefaultConnection": ""
  },
  "Mongo": {
    "ConnectionString": "mongodb://sigref:SuperSecretPassword@mongo-sigref-logs:27017",
    "Database": "sigref_logs"
  },
  "AllowURLS": [
    "http://localhost:5173",
    "http://localhost:3000",
    "http://localhost:4200"
  ],
  "Fhir": {
    "BaseUrl": "http://localhost:8080/fhir" // Local HAPI FHIR Server
    // "BaseUrl": "https://hapi.solarium.dev/fhir"        // Public HAPI FHIR Server
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/sigref", // Keycloak URL (Realm)
    "Audience": "backend", // Client ID
    "RequireHttps": false // Cambiar a true en producción
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug"
    }
  },
  "Parameters": {
    "postgres-password": "sigref",
    "mongodb-password": "sigref",
    "keycloak-user": "sigref",
    "keycloak-pass": "sigref"
  }
}
